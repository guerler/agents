{
  "name": "visualizations: a structure opens in a structure viewer",
  "description": "A protein structure, which vega_dataset cannot read because it is not tabular, so the route is a Galaxy visualization. Showing and saving both open it; a show must leave nothing saved, since rendering once cost a permanent row in the user's visualization list, and a save must be a structure viewer on the dataset.",
  "tier": 3,
  "substrate": "live",
  "dataset": {
    "file": "peptide.pdb",
    "history": "structure viewing $run",
    "datatype": "pdb"
  },
  "inputs": [
    "In my history \"structure viewing $run\" there is a protein structure. Open it in a structure viewer."
  ],
  "timeoutMs": 240000,
  "assertions": {
    "events": {
      "mustInclude": [
        "turn_start"
      ]
    },
    "messages": {
      "repliesInChat": true
    },
    "artifacts": {
      "mustInclude": [
        {
          "kind": "visualization",
          "plugin": [
            "ngl",
            "molstar"
          ],
          "dataset": "$staged:peptide.pdb"
        }
      ]
    },
    "anyOf": [
      {
        "toolCalls": {
          "mustInclude": [
            {
              "name": "show_visualization",
              "argsContains": {
                "dataset_id": "$staged:peptide.pdb"
              }
            }
          ]
        },
        "visualization": {
          "absent": true,
          "referencesDataset": "$staged:peptide.pdb"
        }
      },
      {
        "toolCalls": {
          "mustInclude": [
            {
              "name": "save_visualization",
              "argsContains": {
                "dataset_id": "$staged:peptide.pdb"
              }
            }
          ]
        },
        "visualization": {
          "referencesDataset": "$staged:peptide.pdb",
          "type": [
            "ngl",
            "molstar"
          ]
        }
      }
    ],
    "budget": {
      "maxSteps": 15,
      "maxRepeatedCall": 3
    }
  }
}
